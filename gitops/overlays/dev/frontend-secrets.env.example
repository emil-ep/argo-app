# Frontend Secrets Configuration
# Copy this file to frontend-secrets.env and fill in your actual values
# DO NOT commit frontend-secrets.env to version control

# Instana End User Monitoring (EUM) key for frontend monitoring
# Get this from your Instana account: Settings > Websites & Mobile Apps
instana.eum.key=CHANGE_ME_INSTANA_EUM_KEY

# Datadog Real User Monitoring (RUM) & distributed tracing for frontend
# Get Application ID & Client Token from: Datadog UI → UX Monitoring → RUM Applications
datadog.application.id=CHANGE_ME_DD_APPLICATION_ID
datadog.client.token=CHANGE_ME_DD_CLIENT_TOKEN
datadog.site=datadoghq.com